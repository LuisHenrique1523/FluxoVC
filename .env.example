# Copie este arquivo para ".env" (o .env NÃO vai para o git) e ajuste os valores.
# Tudo aqui é opcional: sem .env, o FluxoVC usa o VLM local.

# VLM do botão "Descrever cena": "local" (padrão, o frame não sai do computador)
# ou "claude" (API da Anthropic; envia o frame já anonimizado).
FLUXOVC_VLM_BACKEND=local

# Modelo local do Hugging Face (baixado na primeira vez para pesos/hf/).
# Alternativa mais precisa e ~2× mais lenta: HuggingFaceTB/SmolVLM-500M-Instruct
FLUXOVC_VLM_MODELO_LOCAL=HuggingFaceTB/SmolVLM-256M-Instruct

# Só para FLUXOVC_VLM_BACKEND=claude
FLUXOVC_VLM_MODELO_CLAUDE=claude-opus-5-5
ANTHROPIC_API_KEY=
